# Clave compartida entre el ESP, el AJ y el dashboard.
API_KEY=cambia-esto-por-algo-largo

# Permite leer /api/feed y /api/meta sin key (el dashboard público).
PUBLIC_READ=false

# Un server de Roblox se borra del hub si nadie reporta en este tiempo.
SERVER_TTL_SEC=480

# Cuánto dura el claim de un job antes de liberarse solo.
CLAIM_TTL_SEC=240

# Railway inyecta PORT automáticamente; sólo se usa en local.
PORT=3000
