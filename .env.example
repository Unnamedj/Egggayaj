# Shared key between the ESP, the AJ and the dashboard. Everything that writes
# needs it, and so does taking a job id out of the pool.
API_KEY=change-this-to-something-long

# Lets /api/feed and /api/meta be read without a key (a public dashboard).
# It deliberately does NOT open the job-id dispenser.
PUBLIC_READ=false

# A Roblox server is dropped from the hub if nobody reports it for this long.
SERVER_TTL_SEC=480

# How long a claim on a job lasts before it frees itself.
CLAIM_TTL_SEC=240

# Railway injects PORT automatically; this is only used locally.
PORT=3000


# ─────────────────────────────────────────────────────── job-id pool (scraper)

# The Roblox place whose public servers get scraped.
GAME_ID=107778070777162

# Set to 0 to stop scraping entirely (useful for a second instance that should
# share one proxy account rather than double its request rate).
FETCHER_ENABLED=1

# Proxy lines, separated by commas or newlines. This wins over PROXY_FILE, and
# is the right place for them on Railway, where the filesystem is rebuilt from
# git on every deploy. Accepted per line:
#   user:pass@host:port   host:port:user:pass   user:pass:host:port
#   http://user:pass@host:port   host:port
# With none set, the scraper goes out from this host's own IP and Roblox
# rate-limits it within seconds.
# PROXIES=user:pass@gate.example.com:8000,user:pass@gate.example.com:8001

# Alternative to PROXIES: a file with one proxy per line ('#' comments allowed).
# PROXY_FILE=proxies.txt

# How many scrape loops run in parallel. Raise it with the number of proxies you
# have; with none configured it is clamped to 2 whatever this says.
SCRAPER_WORKERS=10

# Simultaneous connections through ONE proxy. Guards a single saturated gateway.
AGENT_MAX_SOCKETS=4

# Requests in flight across the whole process. This is what protects the proxy
# ACCOUNT: exceeding the plan's concurrent-session limit arrives as a wave of
# 502s and TLS resets, and more proxies will not fix it — this queue will.
MAX_CONCURRENT_REQUESTS=5

# How long a dispensed job id is held back before it can be handed out again.
RECYCLE_SEC=90
