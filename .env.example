# Shared key between the ESP, the AJ and the dashboard. Everything that writes
# needs it, and so does taking a job id out of the pool.
API_KEY=change-this-to-something-long

# Lets /api/feed and /api/meta be read without a key (a public dashboard).
# It deliberately does NOT open the job-id dispenser.
PUBLIC_READ=false

# A Roblox server is dropped from the hub if nobody reports it for this long.
SERVER_TTL_SEC=480

# How long a claim on a job lasts before it frees itself.
CLAIM_TTL_SEC=240

# Railway injects PORT automatically; this is only used locally.
PORT=3000


# ─────────────────────────────────────────────────────── job-id pool (scraper)

# The Roblox place whose public servers get scraped.
GAME_ID=107778070777162

# Set to 0 to stop scraping entirely (useful for a second instance that should
# share one proxy account rather than double its request rate).
FETCHER_ENABLED=1

# Proxies normally go in proxies.txt (one per line, committed to git in this
# repo so it can be edited from GitHub — keep this repo PRIVATE if it holds
# real credentials). This PROXIES env var is an alternative that WINS OVER
# proxies.txt when set, comma or newline separated, same formats as the file:
#   user:pass@host:port   host:port:user:pass   user:pass:host:port
#   http://user:pass@host:port   host:port
# With neither set, the scraper goes out from this host's own IP and Roblox
# rate-limits it within seconds.
# PROXIES=user:pass@gate.example.com:8000,user:pass@gate.example.com:8001

# proxies.txt lives at the repo root by default; point elsewhere if needed.
# PROXY_FILE=proxies.txt

# How many scrape loops run in parallel. Raise it with the number of proxies you
# have; with none configured it is clamped to 2 whatever this says.
SCRAPER_WORKERS=10

# Simultaneous connections through ONE proxy. Guards a single saturated gateway.
AGENT_MAX_SOCKETS=4

# Requests in flight across the whole process. This is what protects the proxy
# ACCOUNT: exceeding the plan's concurrent-session limit arrives as a wave of
# 502s and TLS resets, and more proxies will not fix it — this queue will.
MAX_CONCURRENT_REQUESTS=5

# How long a dispensed job id is held back before it can be handed out again.
RECYCLE_SEC=90


# ────────────────────────────────────────────────────────── discord alerts

# Routes live in webhooks.json (committed). Each of these overrides the
# matching entry there, so a leaked or rotated webhook is swapped without a
# commit. Set one to a blank string to disable that route.
# WEBHOOK_SECRET=https://discord.com/api/webhooks/...
# WEBHOOK_ETERNAL=https://discord.com/api/webhooks/...
# WEBHOOK_DIVINE=https://discord.com/api/webhooks/...
# WEBHOOK_INSANE=https://discord.com/api/webhooks/...
# WEBHOOK_LOGS=https://discord.com/api/webhooks/...

# Weight that earns an alert on its own, whatever the rarity. 5000 comes from
# the live hub: ordinary Eternals sit near 2,400 kg and the heaviest seen was
# 8,402. Check maxKg in /api/meta and move this if the scale shifts.
INSANE_KG=5000

# Which scraper log levels reach the logs channel. info is deliberately out:
# the workers emit a line per cycle and one per 429, which buries the channel.
WEBHOOK_LOG_LEVELS=warn,error

# Log lines are batched into one message on this timer, with identical lines
# collapsed into "xN".
WEBHOOK_LOG_FLUSH_SEC=20

# How often the status card is posted to the logs channel. 0 disables it.
WEBHOOK_SUMMARY_MIN=15
